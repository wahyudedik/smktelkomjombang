# ========================================
# APP CONFIGURATION
# ========================================
APP_NAME="SMK Telkom"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ========================================
# LOGGING
# ========================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ========================================
# DATABASE
# ========================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=telkom_db
DB_USERNAME=root
DB_PASSWORD=

# ========================================
# SESSION & CACHE
# ========================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# ========================================
# REDIS (optional, jika menggunakan Redis)
# ========================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ========================================
# MAIL CONFIGURATION
# ========================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ========================================
# AWS S3 (optional)
# ========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ========================================
# VITE
# ========================================
VITE_APP_NAME="${APP_NAME}"

# ========================================
# INSTAGRAM BUSINESS API
# ========================================
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://your-domain.test/instagram/callback
INSTAGRAM_WEBHOOK_URI=https://your-domain.test/instagram/webhook
INSTAGRAM_WEBHOOK_TOKEN=

# ========================================
# VAPID (Web Push Notifications)
# ========================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://your-domain.test

# ========================================
# ATTENDANCE ZKTeco iClock — Push Config
# ========================================
ATTENDANCE_ICLOCK_SECRET=
ATTENDANCE_REQUIRE_USER_IDENTITY=false
ATTENDANCE_REQUIRE_USER_VERIFIED=false

# ========================================
# ATTENDANCE SYNC
# ========================================
ATTENDANCE_SYNC_ENABLED=true
ATTENDANCE_SYNC_INTERVAL=5
ATTENDANCE_SYNC_BATCH_SIZE=100

# ========================================
# ATTENDANCE WORK HOURS
# ========================================
ATTENDANCE_WORK_START=07:00
ATTENDANCE_WORK_END=15:00
ATTENDANCE_LATE_THRESHOLD=07:30
ATTENDANCE_LATE_GRACE_MINUTES=0
ATTENDANCE_ALPHA_MARK_TIME=23:00

# ========================================
# ATTENDANCE OVERTIME
# ========================================
ATTENDANCE_OVERTIME_ENABLED=false
ATTENDANCE_OVERTIME_START=16:00
ATTENDANCE_OVERTIME_RATE=0

# ========================================
# ATTENDANCE EXPORT
# ========================================
ATTENDANCE_EXPORT_FORMAT=xlsx
ATTENDANCE_EXPORT_LOGO=
ATTENDANCE_EXPORT_INSTITUTION="SMK Telekomunikasi Darul Ulum"

# ========================================
# ATTENDANCE NOTIFICATION
# ========================================
ATTENDANCE_NOTIFY_ENABLED=true
ATTENDANCE_NOTIFY_SUMMARY_TIME=16:00
ATTENDANCE_NOTIFY_ALPHA_TIME=23:00
ATTENDANCE_NOTIFY_LATE=true
ATTENDANCE_NOTIFY_ALPHA=true
ATTENDANCE_NOTIFY_TARGETS=admin

# ========================================
# ATTENDANCE REPORT
# ========================================
ATTENDANCE_WORK_DAYS_PER_WEEK=6
ATTENDANCE_WORK_DAYS_PER_MONTH=25
ATTENDANCE_REPORT_SHOW_PHOTO=true
ATTENDANCE_REPORT_SHOW_CHARTS=true
ATTENDANCE_REPORT_DATE_FORMAT=d/m/Y
ATTENDANCE_REPORT_TIME_FORMAT=H:i

# ========================================
# ATTENDANCE BIOMETRIC
# ========================================
ATTENDANCE_BIOMETRIC_MODE=fingerprint
ATTENDANCE_MULTI_TEMPLATE=true

# ========================================
# ATTENDANCE CLEANUP
# ========================================
ATTENDANCE_CLEANUP_ENABLED=false
ATTENDANCE_CLEANUP_RETENTION_DAYS=365

# ========================================
# THEME SWITCHING (telkom | maudu)
# ========================================
DEFAULT_THEME=telkom
