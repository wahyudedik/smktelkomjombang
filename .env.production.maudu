# =============================================================================
# .env.production.maudu — Template Environment Variables untuk MAUDU
# =============================================================================
# Copy file ini ke .env di VPS saat deploy tema MAUDU:
#   cp .env.production.maudu .env
#
# Domain: https://maudu-rejoso.sch.id
# Database: sekolah
# Default Theme: maudu
# =============================================================================

APP_NAME="Maudu Rejoso"
APP_ENV=production
APP_KEY=base64:PLACEHOLDER_APP_KEY_MAUDU
APP_DEBUG=false
APP_URL=https://maudu-rejoso.sch.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database MAUDU ───────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sekolah
DB_USERNAME=sekolah
DB_PASSWORD=PLACEHOLDER_DB_PASSWORD_MAUDU

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=PLACEHOLDER_MAIL_USERNAME
MAIL_PASSWORD=PLACEHOLDER_MAIL_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Instagram Business API (MAUDU) ──────────────────────────────────────────
INSTAGRAM_APP_ID=1575539400487129
INSTAGRAM_APP_SECRET=7b6f727ebfd70393214e92b9b93676c3
INSTAGRAM_REDIRECT_URI=https://maudu-rejoso.sch.id/instagram/callback
INSTAGRAM_WEBHOOK_URI=
INSTAGRAM_WEBHOOK_TOKEN=mySchoolWebhook2025

# ── Push Notification VAPID (MAUDU) ─────────────────────────────────────────
VAPID_PUBLIC_KEY=PLACEHOLDER_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=PLACEHOLDER_VAPID_PRIVATE_KEY
VAPID_SUBJECT=https://maudu-rejoso.sch.id

# ── Attendance ZKTeco iClock Push ───────────────────────────────────────────
ATTENDANCE_ICLOCK_SECRET=
ATTENDANCE_REQUIRE_USER_IDENTITY=false
ATTENDANCE_REQUIRE_USER_VERIFIED=false

# ── Attendance Sync ─────────────────────────────────────────────────────────
ATTENDANCE_SYNC_ENABLED=true
ATTENDANCE_SYNC_INTERVAL=5
ATTENDANCE_SYNC_BATCH_SIZE=100

# ── Attendance Work Hours ───────────────────────────────────────────────────
ATTENDANCE_WORK_START=07:00
ATTENDANCE_WORK_END=15:00
ATTENDANCE_LATE_THRESHOLD=07:30
ATTENDANCE_LATE_GRACE_MINUTES=0
ATTENDANCE_ALPHA_MARK_TIME=23:00

# ── Attendance Overtime ─────────────────────────────────────────────────────
ATTENDANCE_OVERTIME_ENABLED=false
ATTENDANCE_OVERTIME_START=16:00
ATTENDANCE_OVERTIME_RATE=0

# ── Attendance Export (MAUDU) ───────────────────────────────────────────────
ATTENDANCE_EXPORT_FORMAT=xlsx
ATTENDANCE_EXPORT_LOGO=
ATTENDANCE_EXPORT_INSTITUTION="Maudu Rejoso"

# ── Attendance Notification ─────────────────────────────────────────────────
ATTENDANCE_NOTIFY_ENABLED=true
ATTENDANCE_NOTIFY_SUMMARY_TIME=16:00
ATTENDANCE_NOTIFY_ALPHA_TIME=23:00
ATTENDANCE_NOTIFY_LATE=true
ATTENDANCE_NOTIFY_ALPHA=true
ATTENDANCE_NOTIFY_TARGETS=admin

# ── Attendance Report ───────────────────────────────────────────────────────
ATTENDANCE_WORK_DAYS_PER_WEEK=6
ATTENDANCE_WORK_DAYS_PER_MONTH=25
ATTENDANCE_REPORT_SHOW_PHOTO=true
ATTENDANCE_REPORT_SHOW_CHARTS=true
ATTENDANCE_REPORT_DATE_FORMAT=d/m/Y
ATTENDANCE_REPORT_TIME_FORMAT=H:i

# ── Attendance Biometric ────────────────────────────────────────────────────
ATTENDANCE_BIOMETRIC_MODE=fingerprint
ATTENDANCE_MULTI_TEMPLATE=true

# ── Attendance Cleanup ──────────────────────────────────────────────────────
ATTENDANCE_CLEANUP_ENABLED=false
ATTENDANCE_CLEANUP_RETENTION_DAYS=365

# ── Internationalization ────────────────────────────────────────────────────
APP_CURRENCY=IDR

# ── Theme (MAUDU) ───────────────────────────────────────────────────────────
DEFAULT_THEME=maudu
